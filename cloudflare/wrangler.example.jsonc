{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "asas-business-suite-api-staging",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asas-suite-staging",
      "database_id": "REPLACE_WITH_NEW_ASAS_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ]
}
